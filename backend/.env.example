# CoalSmart backend configuration — copy to .env (or export) and adjust.
# The server reads these via process.env; there is no dotenv loader, so either
# export them in the shell or run through scripts/deploy.sh which sources .env.

# HTTP port for the Express server (WebSocket upgrades on the same port).
PORT=8001

# SQLite database file. Defaults to backend/data/coalsmart.db.
# Point at a scratch file for tests (they set this themselves via mkdtemp).
COALSMART_DB=./data/coalsmart.db

# Directory that stores field-uploaded photos served under /uploads/field.
COALSMART_UPLOADS=./uploads/field

# Alert engine ticker interval in milliseconds (0 disables the interval).
ALERTS_TICK_MS=30000

# Compliance escalation ticker interval in milliseconds (0 disables).
# Read by src/engine/escalation.js as COMPLIANCE_TICK_MS.
COMPLIANCE_TICK_MS=60000

# Feature 13 — AI Compliance Assistant (Gemma 3 via local Ollama,
# OpenAI-compatible). Point LLM_BASE_URL at "" to disable the model and
# force the deterministic local responder. LLM_API_KEY is optional —
# Ollama accepts requests without one.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=
